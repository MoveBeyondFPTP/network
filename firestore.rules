rules_version = '2';

// Each signed-in person can only read and write their own folder: users/{their id}/...
// Paste this into Firebase → Firestore Database → Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.token.email == "YOUR_EMAIL_HERE";
    }
  }
}
